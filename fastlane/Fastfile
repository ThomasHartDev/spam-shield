default_platform(:ios)

# CI flow:
#   1. xcodegen generate           -> SpamShield.xcodeproj
#   2. fastlane beta                -> auto-sign with App Store Connect API key,
#                                      build, upload to TestFlight
#
# Required env (CI): APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID,
#                    APP_STORE_CONNECT_API_KEY (base64 of .p8), APPLE_TEAM_ID

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true,
      duration: 1200
    )

    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: ENV["APPLE_TEAM_ID"],
      path: "SpamShield.xcodeproj",
      targets: ["SpamShield", "SpamShieldCallDirectory"]
    )

    # Monotonic build number based on the run timestamp so we never collide
    # with prior TestFlight uploads even if App Store Connect lookup fails
    # (e.g. on the very first build before the app exists).
    increment_build_number(
      build_number: Time.now.utc.strftime("%Y%m%d%H%M"),
      xcodeproj: "SpamShield.xcodeproj"
    )

    build_app(
      scheme: "SpamShield",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      output_directory: "build",
      output_name: "SpamShield.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
